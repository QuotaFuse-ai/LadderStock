{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schedule.yaml",
  "type": "object",
  "required": [
    "scheduler",
    "jobs"
  ],
  "additionalProperties": false,
  "properties": {
    "scheduler": {
      "type": "object",
      "required": [
        "timezone",
        "misfire_grace_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "misfire_grace_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "trigger",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "notify",
              "reconcile",
              "snapshot",
              "sync_close",
              "snapshot_fast",
              "sync_batch",
              "digest",
              "wire_news",
              "knowledge_refresh",
              "agent_research",
              "watch_alert",
              "watch_live",
              "sentiment_live",
              "plan_tick",
              "sync_evening"
            ]
          },
          "trigger": {
            "type": "string",
            "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|[1-9][0-9]*s)$"
          },
          "enabled": {
            "type": "boolean"
          },
          "channel": {
            "enum": [
              "console",
              "desktop"
            ]
          },
          "message": {
            "type": "string"
          },
          "summary": {
            "enum": [
              "premarket",
              "close",
              "watch"
            ]
          },
          "dataset": {
            "type": "string",
            "minLength": 1
          },
          "datasets": {
            "type": "string",
            "minLength": 1,
            "description": "sync_evening：逗号分隔的数据集清单（缺省 dragon_tiger,dragon_tiger_seats）"
          },
          "daily_limit": {
            "type": "integer",
            "minimum": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 6
            }
          },
          "alert_pct": {
            "type": "number",
            "minimum": 0.1
          },
          "move_pct": {
            "type": "number",
            "minimum": 0.1,
            "description": "盘中盯盘：较上一次快照的变动阈值（百分比）"
          },
          "min_gap_min": {
            "type": "number",
            "minimum": 1,
            "description": "盘中盯盘：同一只票两次提醒的最小间隔（分钟）"
          },
          "auto_research": {
            "type": "boolean",
            "description": "盘中盯盘：命中阈值后自动起一轮 agent 研究（条件触发）"
          },
          "auto_research_question": {
            "type": "string",
            "minLength": 1,
            "description": "自动研究的提问；不填用内置模板（发生了什么/可能原因/接下来盯什么）"
          },
          "auto_research_max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "一次异动最多自动研究几只（默认 2）"
          },
          "auto_research_cooldown_min": {
            "type": "number",
            "minimum": 1,
            "description": "同一只票两次自动研究的最小间隔（分钟，默认 60）"
          },
          "allow_plan_create": {
            "type": "boolean",
            "description": "跨轮任务推进：这一轮的回答是否允许再建新任务（默认 false，防止推进自我繁殖）"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "sync_batch"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "dataset"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "digest"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "summary"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "agent_research"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "question"
              ]
            }
          }
        ]
      }
    }
  }
}
