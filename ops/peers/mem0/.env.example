# LadderStock 助手专用 mem0（项目 qf-mem0）—— 与 Multica 的 mem0(9000) 严格隔离。
# 一键安装（QUOT-569）会基于本模板生成 <peer 目录>/.env：
#   - POSTGRES_PASSWORD / JWT_SECRET 由安装器自动生成随机值；
#   - 其余键保留本模板默认值；
#   - OPENAI_API_KEY 不落任何文件：由 docker-compose.yml 的 environment 段
#     以 ${LDST_LLM_API_KEY} 从 Windows 机器级环境变量替换注入，缺失时 compose
#     直接报错，不会静默走空 key。

# ---- postgres（qf-mem0 自己的实例，独立端口 8532）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_RANDOM

# ---- dashboard/API 鉴权 ----
JWT_SECRET=CHANGE_ME_RANDOM
AUTH_DISABLED=true
MEM0_TELEMETRY=false

# ---- LLM：云骏（DeepSeek 兼容端点）----
OPENAI_BASE_URL=https://api.1k0.com/v1
MEM0_DEFAULT_LLM_MODEL=deepseek-v4.1-flash-1017

# ---- Embedding：本地 huggingface（云骏无 embedding 接口，勿换 text-embedding）----
MEM0_EMBEDDER_PROVIDER=huggingface
MEM0_DEFAULT_EMBEDDER_MODEL=BAAI/bge-small-zh-v1.5
MEM0_DEFAULT_EMBEDDER_DIM=512
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ---- 集合名独立（不与任何其他实例共用）----
POSTGRES_COLLECTION_NAME=ladderstock_memories
APP_DB_NAME=mem0_app
