FROM qf-mem0/mem0:latest

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=

COPY . /app/

RUN pip install --no-cache-dir -q -i https://pypi.tuna.tsinghua.edu.cn/simple --force-reinstall --no-deps mem0ai==2.2.1 \
 && pip install --no-cache-dir -q -i https://pypi.tuna.tsinghua.edu.cn/simple sentence-transformers==6.1.0 \
 && python -c "import mem0, sentence_transformers; print('runtime imports ok')"

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
