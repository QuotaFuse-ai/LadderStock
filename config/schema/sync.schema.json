{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sync.yaml",
  "description": "数据集增量同步：只引用 sources.yaml 的 source id，主备必须同 peer（文档 §6.2 + §9）。",
  "type": "object",
  "required": ["sync"],
  "additionalProperties": false,
  "properties": {
    "sync": {
      "type": "object",
      "required": ["datasets"],
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["primary", "watermark_field", "mode"],
            "additionalProperties": false,
            "properties": {
              "primary": { "type": "string" },
              "fallback": { "type": "array", "items": { "type": "string" }, "default": [] },
              "optional": { "type": "boolean", "default": false },
              "watermark_field": { "type": "string" },
              "mode": { "enum": ["append", "replace"] },
              "codes": {
                "type": "array",
                "description": "代码池（QUOT-233）：tencent_kline / stock_fund_flow / dragon_tiger_seats 的 code 必填，逐只取数。优先级：--codes > 本键 > 本机自选表。为空则该数据集判 failed 且不发起调用。",
                "items": { "type": "string", "pattern": "^[0-9A-Za-z.]{1,12}$" },
                "maxItems": 100,
                "default": []
              },
              "topics": {
                "type": "array",
                "description": "赛道池（QUOT-328）：Wire 的 wire_get_digest 的 topic 必填且只认赛道 slug（semiconductor，不是「半导体」），逐赛道取数。为空则该数据集判 skipped（optional 时）且不发起调用。",
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
                "maxItems": 100,
                "default": []
              }
            }
          }
        },
        "cold_hot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intraday_cache_ttl_sec": { "type": "number", "minimum": 0 },
            "history_backend": { "enum": ["duckdb", "parquet"] }
          }
        }
      }
    }
  }
}
