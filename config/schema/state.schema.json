{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "state.yaml",
  "type": "object",
  "required": ["state"],
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "object",
      "required": ["backend", "stores", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "backend": { "enum": ["indexeddb", "memory"] },
        "schema_version": { "type": "integer", "minimum": 1 },
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "persist"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "persist": { "type": "boolean" },
              "ttl_sec": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
