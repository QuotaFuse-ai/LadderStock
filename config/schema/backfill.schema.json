{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backfill.yaml",
  "type": "object",
  "required": ["backfill"],
  "additionalProperties": false,
  "properties": {
    "backfill": {
      "type": "object",
      "required": [
        "source",
        "stage",
        "start",
        "target_years",
        "throttle_ms",
        "max_consecutive_failures",
        "gap_rate_threshold",
        "report_dir",
        "benchmark",
        "universe"
      ],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["config", "tencent", "eastmoney"] },
        "stage": { "type": "string", "minLength": 1 },
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "target_years": { "type": "number", "exclusiveMinimum": 0 },
        "throttle_ms": { "type": "integer", "minimum": 0 },
        "max_consecutive_failures": { "type": "integer", "minimum": 1 },
        "gap_rate_threshold": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "report_dir": { "type": "string", "minLength": 1 },
        "benchmark": {
          "type": "object",
          "required": ["code", "days"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "days": { "type": "integer", "minimum": 1 }
          }
        },
        "universe": {
          "type": "array",
          "minItems": 20,
          "items": {
            "type": "object",
            "required": ["code"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^[0-9]{6}$" },
              "name": { "type": "string" },
              "board": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
