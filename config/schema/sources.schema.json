{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources.yaml",
  "description": "只描述向生态 peer 的哪个工具取数，不描述行情供应商（文档 §6.1 + §9）。",
  "type": "object",
  "required": ["peers", "sources"],
  "additionalProperties": false,
  "properties": {
    "peers": {
      "type": "object",
      "required": ["tickhub", "tickhub_us", "wire", "senate"],
      "additionalProperties": false,
      "properties": {
        "tickhub": { "$ref": "#/$defs/peer" },
        "tickhub_us": { "$ref": "#/$defs/peer" },
        "wire": { "$ref": "#/$defs/peer" },
        "senate": { "$ref": "#/$defs/peer" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "dataset", "via", "tool", "primary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "dataset": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "via": { "enum": ["tickhub", "tickhub_us", "wire", "senate"] },
          "tool": { "type": "string", "minLength": 1 },
          "primary": { "type": "boolean" },
          "fallback": { "type": "array", "items": { "type": "string" }, "default": [] },
          "timeout_sec": { "type": "number", "exclusiveMinimum": 0 },
          "retries": { "type": "integer", "minimum": 0 },
          "cooldown_sec": { "type": "number", "minimum": 0 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "peer": {
      "type": "object",
      "required": ["product", "package", "cli", "mcp_name", "url_env", "default_url"],
      "additionalProperties": false,
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "cli": { "type": "string", "minLength": 1 },
        "mcp_name": { "type": "string", "minLength": 1 },
        "url_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "default_url": { "type": "string", "pattern": "^https?://" },
        "timeout_sec": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
