{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources.yaml",
  "description": "只描述向生态 peer 的哪个工具取数，不描述行情供应商（文档 §6.1 + §9）。",
  "type": "object",
  "required": ["peers", "sources"],
  "additionalProperties": false,
  "properties": {
    "peers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/peer" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "dataset", "via", "tool", "primary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "dataset": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "via": { "enum": ["tickhub", "tickhub_us", "wire", "senate"] },
          "tool": { "type": "string", "minLength": 1 },
          "primary": { "type": "boolean" },
          "fallback": { "type": "array", "items": { "type": "string" }, "default": [] },
          "timeout_sec": { "type": "number", "exclusiveMinimum": 0 },
          "retries": { "type": "integer", "minimum": 0 },
          "cooldown_sec": { "type": "number", "minimum": 0 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "peer": {
      "type": "object",
      "required": ["product", "package", "cli", "url_env", "default_url", "health_path", "default_port", "role"],
      "additionalProperties": false,
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "cli": { "type": "string", "minLength": 1 },
        "mcp_name": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "该 peer 的 MCP 工具名；没有 MCP 面（如 FinanceCoffer）写 null"
        },
        "url_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "default_url": { "type": "string", "pattern": "^https?://" },
        "timeout_sec": { "type": "number", "exclusiveMinimum": 0 },
        "health_path": {
          "type": "string",
          "pattern": "^/",
          "description": "该 peer 真实提供的健康检查路径（探测用，QUOT-403）"
        },
        "default_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "主服务端口（MCP 或 HTTP）"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "控制面模块卡上显示的一句话职责"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$",
          "description": "GitHub 仓库名（owner/name），QUOT-402 期望版本的来源"
        }
      }
    }
  }
}
