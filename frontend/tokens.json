{
  "meta": {
    "name": "LadderStock Design Tokens",
    "version": "2.0.0",
    "date": "2026-10-28",
    "owner": "UI/UX",
    "scope": "5950 看板（React + Vite，仅回环），6 屏 + 设置页",
    "cssVarPrefix": "--ldst-",
    "themes": [
      "dark",
      "light"
    ],
    "defaultTheme": "dark",
    "themeAttribute": "data-ldst-theme",
    "colorSchemeAttribute": "data-ldst-scheme",
    "companionDoc": "docs/tasks/TASK-UI-REDESIGN/DESIGN-SPEC.md",
    "handoffNote": "本文件是机读真源；DESIGN-SPEC.md 的令牌表由本文件逐条对应。前端据此生成 frontend/src/styles/tokens.css 与 tailwind.config.ts 的 theme.extend：颜色/圆角/阴影/间距一律映射到 CSS 变量（var(--ldst-*)），不把 hex 写进 tailwind 配置，否则深色主题无法切换。",
    "contrastPolicy": "正文（14px 及以上）文本与其实际底色对比度 ≥ 4.5:1；12px 辅助文字 ≥ 4.5:1；交互件边框与图标 ≥ 3:1。校验值记录在 DESIGN-SPEC.md 表 2-8。",
    "units": "px，除非另注；alpha 值以 rgba() 给出"
  },
  "color": {
