# LadderStock 环境变量示例（复制成 .env 后按需填写；.env 已在 .gitignore 中）
#
# 原则：密钥只走环境变量，不写进 config/*.yaml，也永远不进日志。
# 兼容期仍接受旧前缀 VRA_* / VIBE_ASTOCK_*，但 LDST_* 永远优先（见 docs/CONFIG.md §2）。

# ---- 目录（默认：当前工作目录的 config/ 与 data/，否则 ~/.ladderstock/）----
# LDST_CONFIG_DIR=[local-path]/LadderStock/config
# LDST_DATA_DIR=[local-path]/LadderStock/data

# ---- 生态 peer（DEC-006：只消费，不采集）----
# LDST_TICKHUB_MCP_URL=http://127.0.0.1:8000/mcp
# LDST_TICKHUB_US_MCP_URL=http://127.0.0.1:8002/mcp
# LDST_WIRE_MCP_URL=http://127.0.0.1:8791/mcp
# LDST_SENATE_MCP_URL=http://127.0.0.1:8765/mcp

# ---- 控制面（DEC-014，看板 /api/control/*）----
# 默认开启；设为 0/false/no/off 时整族 404（数据面只读接口不受影响）。
# 只有回环来源可访问，非回环 403，端口不可配置成 0.0.0.0。
# LDST_CONTROL_ENABLED=1

# ---- AI provider（config/ai.yaml: backends[] 里声明的环境变量名）----
# 每个后端一组「地址 + 密钥」：凭据齐全的后端才进入模型链，缺一组就静默跳过
# 该后端、其余照常；全都没配则走离线降级（退出码 9），不会自动外联。
# openai 兼容后端（旧配置的默认后端也是这一组）
# LDST_LLM_BASE_URL=https://api.example.com/v1
# LDST_LLM_API_KEY=
# anthropic Messages 后端（POST {base}/v1/messages）
# LDST_LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# LDST_LLM_ANTHROPIC_API_KEY=

# ---- 助手记忆（QUOT-487，mem0 REST，默认 QUOT-486 的本机实例）----
# 缺省 http://127.0.0.1:9100；显式置空则整条记忆通道关闭（请求不带记忆、不写入）。
# LDST_MEMORY_BASE_URL=http://127.0.0.1:9100
# 固定单用户标识（不设则在本机 data/ 下持久生成，绝不写死 "default"）
# LDST_MEMORY_USER_ID=
# 召回条数（≥1，默认 5）与分数阈值（默认 0.55，低于阈值不注入）
# LDST_MEMORY_TOP_K=5
# LDST_MEMORY_SCORE_THRESHOLD=0.55
# 单次召回/写入超时秒（默认 5.0）
# LDST_MEMORY_TIMEOUT_SEC=5.0
# LDST_MEMORY_ENABLED=1

# ---- 旧版迁移（可选，过渡期用）----
# LDST_LEGACY_CONFIG_DIR=
# LDST_LEGACY_DATA_DIR=
# LDST_SKIP_AUTO_MIGRATE=1

# ---- 本机能力（可选）----
# LDST_CJK_FONT=C:/Windows/Fonts/msyh.ttc
# LDST_DESKTOP_NOTIFY_CMD=

# ---- 对外监听（默认只监听回环，无需任何配置）----
# 只有确实要对外提供服务时才设置：两个必须同时给，否则拒绝启动（DEC-004）
# web（ldst run，5950）：/api/* 需要 Bearer
# LDST_WEB_ALLOW_REMOTE=1
# LDST_WEB_TOKEN=至少16位随机串
# MCP（ldst mcp http，5951）：/mcp 需要 Bearer（R-1，与 web 共用同一判据）
# LDST_MCP_ALLOW_REMOTE=1
# LDST_MCP_TOKEN=至少16位随机串
